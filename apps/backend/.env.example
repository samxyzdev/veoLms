COOKIE_SECRET=replace-with-a-long-random-secret
SERVER_PORT=3000

# Comma-separated production frontend origins for Express API requests. These
# must exactly match the deployed frontend origin (no trailing slash).
# CORS_ORIGINS=https://app.example.com

# Optional email delivery
# RESEND_EMAIL_API=re_...

# Optional Cloudflare R2 upload configuration
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET=...
# R2_PUBLIC_URL=https://media.example.com
